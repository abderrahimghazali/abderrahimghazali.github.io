---
/**
 * Song of the day — a static rotation, no API and no credentials.
 *
 * The index is derived from the date, so it advances once per day and is
 * the same for every visitor on a given day. Rendered at build time so it
 * works without JS, then corrected client-side so it keeps rotating
 * between deploys.
 *
 * Swap these for your own; the list can be any length.
 */
const songs = [
  { title: 'Nights', artist: 'Frank Ocean' },
  { title: 'Teardrop', artist: 'Massive Attack' },
  { title: 'Weird Fishes / Arpeggi', artist: 'Radiohead' },
  { title: 'Redbone', artist: 'Childish Gambino' },
  { title: 'Midnight City', artist: 'M83' },
  { title: 'Glory Box', artist: 'Portishead' },
  { title: 'Instant Crush', artist: 'Daft Punk' },
  { title: 'Time', artist: 'Hans Zimmer' },
  { title: 'The Less I Know the Better', artist: 'Tame Impala' },
  { title: 'Svefn-g-englar', artist: 'Sigur Rós' },
  { title: 'Alright', artist: 'Kendrick Lamar' },
  { title: 'Intro', artist: 'The xx' },
  { title: 'Sunset Lover', artist: 'Petit Biscuit' },
  { title: 'Windowlicker', artist: 'Aphex Twin' },
];

const dayIndex = Math.floor(Date.now() / 86400000) % songs.length;
const song = songs[dayIndex];
const search = (s: { title: string; artist: string }) =>
  `https://open.spotify.com/search/${encodeURIComponent(`${s.title} ${s.artist}`)}`;
---

<a
  class="nowplaying"
  data-song-of-day
  data-songs={JSON.stringify(songs)}
  href={search(song)}
  target="_blank"
  rel="noopener noreferrer"
>
  <div class="np-art" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
      <path d="M9 18V5l10-2v13" />
      <circle cx="6.5" cy="18" r="2.5" />
      <circle cx="16.5" cy="16" r="2.5" />
    </svg>
  </div>

  <div class="np-body">
    <div class="np-status">
      <span class="np-dot" aria-hidden="true"></span>
      Song of the day
    </div>
    <div class="np-title" data-song-title>{song.title}</div>
    <div class="np-artist" data-song-artist>{song.artist}</div>
  </div>

  <img class="np-logo" src="/spotify.png" alt="Find it on Spotify" width="18" height="18" loading="lazy" />
</a>

<script>
  // recompute on load so the rotation advances without a rebuild
  const el = document.querySelector<HTMLElement>('[data-song-of-day]');
  if (el) {
    try {
      const songs = JSON.parse(el.dataset.songs ?? '[]');
      if (songs.length) {
        const today = songs[Math.floor(Date.now() / 86400000) % songs.length];
        el.querySelector<HTMLElement>('[data-song-title]')!.textContent = today.title;
        el.querySelector<HTMLElement>('[data-song-artist]')!.textContent = today.artist;
        (el as HTMLAnchorElement).href =
          `https://open.spotify.com/search/${encodeURIComponent(`${today.title} ${today.artist}`)}`;
      }
    } catch {}
  }
</script>

<style>
  .np-art {
    display: grid;
    place-items: center;
    color: var(--accent);
    background: var(--bg-2);
    border: 1px solid var(--line);
  }
  .np-art svg { width: 19px; height: 19px; }

  /* static marker — the pulsing green dot is reserved for availability */
  .np-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--fg-3);
    flex-shrink: 0;
  }
</style>
