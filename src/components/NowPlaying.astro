---
/**
 * Spotify "last played", fetched at build time.
 *
 * Needs SPOTIFY_CLIENT_ID / SPOTIFY_CLIENT_SECRET / SPOTIFY_REFRESH_TOKEN.
 * See README for how to mint the refresh token — those are your credentials,
 * so create them yourself and store them as repo secrets, never in the repo.
 * Without them this component renders nothing.
 *
 * Build-time means the track is frozen at the last deploy. A scheduled
 * workflow (cron) is what keeps it reasonably fresh.
 */
const clientId = import.meta.env.SPOTIFY_CLIENT_ID ?? process.env.SPOTIFY_CLIENT_ID;
const clientSecret = import.meta.env.SPOTIFY_CLIENT_SECRET ?? process.env.SPOTIFY_CLIENT_SECRET;
const refreshToken = import.meta.env.SPOTIFY_REFRESH_TOKEN ?? process.env.SPOTIFY_REFRESH_TOKEN;

type Track = {
  title: string;
  artist: string;
  art: string | null;
  url: string;
  playing: boolean;
};

let track: Track | null = null;

if (clientId && clientSecret && refreshToken) {
  try {
    const auth = Buffer.from(`${clientId}:${clientSecret}`).toString('base64');

    const tokenRes = await fetch('https://accounts.spotify.com/api/token', {
      method: 'POST',
      headers: {
        Authorization: `Basic ${auth}`,
        'Content-Type': 'application/x-www-form-urlencoded',
      },
      body: new URLSearchParams({
        grant_type: 'refresh_token',
        refresh_token: refreshToken,
      }),
    });

    const { access_token } = await tokenRes.json();
    if (!access_token) throw new Error('token refresh failed');

    const headers = { Authorization: `Bearer ${access_token}` };

    // try what's playing right now, fall back to the last completed play
    let res = await fetch('https://api.spotify.com/v1/me/player/currently-playing', { headers });
    let item: any = null;
    let playing = false;

    if (res.status === 200) {
      const data = await res.json();
      if (data?.item) {
        item = data.item;
        playing = Boolean(data.is_playing);
      }
    }

    if (!item) {
      res = await fetch('https://api.spotify.com/v1/me/player/recently-played?limit=1', { headers });
      if (res.ok) {
        const data = await res.json();
        item = data?.items?.[0]?.track ?? null;
      }
    }

    if (item) {
      track = {
        title: item.name,
        artist: item.artists.map((a: any) => a.name).join(', '),
        art: item.album?.images?.at(-1)?.url ?? null,
        url: item.external_urls?.spotify ?? '#',
        playing,
      };
    }
  } catch (err) {
    console.warn(`[NowPlaying] skipped — ${(err as Error).message}`);
  }
} else {
  console.warn('[NowPlaying] skipped — Spotify credentials not set');
}
---

{track && (
  <a
    class="nowplaying"
    href={track.url}
    target="_blank"
    rel="noopener noreferrer"
    data-playing={String(track.playing)}
  >
    {track.art && <img class="np-art" src={track.art} alt="" width="42" height="42" loading="lazy" />}

    <div class="np-body">
      <div class="np-status">
        <span class="np-dot status-dot" aria-hidden="true"></span>
        <span class="np-bars" aria-hidden="true"><i></i><i></i><i></i></span>
        {track.playing ? 'Now playing' : 'Last played'}
      </div>
      <div class="np-title">{track.title}</div>
      <div class="np-artist">{track.artist}</div>
    </div>

    <svg class="np-logo" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
      <circle cx="12" cy="12" r="9.25" />
      <path d="M7.2 9.1c3.1-.85 6.3-.5 9.1 1" />
      <path d="M7.7 12.1c2.6-.7 5.3-.4 7.7.85" />
      <path d="M8.2 15.1c2.1-.55 4.3-.3 6.2.7" />
    </svg>
  </a>
)}
