---
export interface Props {
  title: string;
  description: string;
  keywords?: string;
  url: string;
  image?: string;
  imageAlt?: string;
  type?: string;
  noindex?: boolean;
}

const { title, description, keywords, url, image, imageAlt, type = 'website', noindex = false } = Astro.props;
const siteUrl = 'https://abderrahimghazali.github.io';
const imageUrl = image ? `${siteUrl}${image}` : `${siteUrl}/me.jpeg`;
const ogImageAlt = imageAlt || 'Abderrahim GHAZALI';
import '../styles/global.css';
import CommandPalette from '../components/CommandPalette.astro';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- SEO Meta Tags -->
    <meta name="description" content={description}>
    {keywords && <meta name="keywords" content={keywords}>}
    <meta name="author" content="Abderrahim GHAZALI">
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-snippet:-1, max-image-preview:large"}>
    <meta name="google-site-verification" content="0569ea929d78514b" />

    <!-- Open Graph -->
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content={type}>
    <meta property="og:image" content={imageUrl}>
    <meta property="og:image:alt" content={ogImageAlt}>
    <meta property="og:url" content={url}>
    <meta property="og:site_name" content="Abderrahim GHAZALI">
    <meta property="og:locale" content="en_US">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={imageUrl}>
    <meta name="twitter:image:alt" content={ogImageAlt}>

    <meta name="theme-color" content="#0b0b0c" media="(prefers-color-scheme: dark)">
    <meta name="theme-color" content="#0b0b0c">
    <link rel="canonical" href={url}>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500&display=swap" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500&display=swap" rel="stylesheet"></noscript>

    <link rel="icon" type="image/svg+xml" href="/icon.svg">
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="apple-touch-icon" href="/favicon.png">
    <link rel="manifest" href="/manifest.json">

    <title>{title}</title>

    <!-- set the theme before first paint so there is no flash -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.setAttribute('data-theme', saved);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <div class="frame" aria-hidden="true"></div>

    <main id="main-content">
      <slot />
    </main>

    <CommandPalette />

    <script is:inline>
      (function () {
        var root = document.documentElement;

        function apply(next) {
          root.setAttribute('data-theme', next);
          try { localStorage.setItem('theme', next); } catch (e) {}
          var meta = document.querySelector('meta[name="theme-color"]:not([media])');
          if (meta) meta.setAttribute('content', next === 'light' ? '#f4f2ec' : '#0b0b0c');
        }

        document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
            var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            if (!document.startViewTransition || reduced) {
              apply(next);
              return;
            }
            document.startViewTransition(function () { apply(next); });
          });
        });
      })();
    </script>

    <!-- WebSite schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Abderrahim GHAZALI",
        "alternateName": "Abderrahim Ghazali Portfolio",
        "url": "https://abderrahimghazali.github.io/",
        "description": "Full-stack engineer since 2014. Drupal architecture and web platforms at scale, plus AI automation and RAG systems since 2022.",
        "author": {
          "@type": "Person",
          "name": "Abderrahim GHAZALI"
        }
      }
    </script>

    <!-- SiteNavigationElement -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "SiteNavigationElement",
            "name": "Home",
            "url": "https://abderrahimghazali.github.io/"
          },
          {
            "@type": "SiteNavigationElement",
            "name": "Work",
            "url": "https://abderrahimghazali.github.io/#work"
          },
          {
            "@type": "SiteNavigationElement",
            "name": "Projects",
            "url": "https://abderrahimghazali.github.io/#projects"
          },
          {
            "@type": "SiteNavigationElement",
            "name": "Stack",
            "url": "https://abderrahimghazali.github.io/#stack"
          },
          {
            "@type": "SiteNavigationElement",
            "name": "Contact",
            "url": "https://abderrahimghazali.github.io/#contact"
          }
        ]
      }
    </script>

    <!-- Person schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Abderrahim GHAZALI",
        "jobTitle": "Full-Stack Engineer",
        "description": "Full-stack engineer since 2014, specializing in enterprise Drupal architecture and web platforms at scale, and since 2022 in AI agent development, RAG pipelines, semantic search, and n8n workflow automation.",
        "url": "https://abderrahimghazali.github.io/",
        "email": "ghazali.abderrahim1@gmail.com",
        "image": "https://abderrahimghazali.github.io/me.jpeg",
        "sameAs": [
          "https://github.com/abderrahimghazali",
          "https://www.linkedin.com/in/abderrahimghazali/",
          "https://www.drupal.org/u/gabderrahim"
        ],
        "knowsAbout": [
          "AI Agent Development",
          "Retrieval-Augmented Generation (RAG)",
          "Semantic Search",
          "LangChain",
          "n8n Workflow Automation",
          "Drupal Development",
          "React",
          "Next.js",
          "Node.js",
          "DevOps",
          "Full-stack Development"
        ],
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "consulting",
          "url": "https://cal.com/abderrahimghazali/15min?overlayCalendar=true",
          "email": "ghazali.abderrahim1@gmail.com",
          "availableLanguage": ["English", "French"]
        },
        "potentialAction": {
          "@type": "ReserveAction",
          "name": "Book a 15-minute call",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": "https://cal.com/abderrahimghazali/15min?overlayCalendar=true",
            "actionPlatform": "https://schema.org/DesktopWebPlatform"
          }
        },
        "offers": [
          {
            "@type": "Service",
            "name": "AI Agent Development",
            "description": "Custom AI agent development, RAG pipelines, and semantic search solutions for business process automation"
          },
          {
            "@type": "Service",
            "name": "Workflow Automation",
            "description": "End-to-end workflow automation using custom n8n pipelines and LangChain orchestration"
          },
          {
            "@type": "Service",
            "name": "Drupal Architecture",
            "description": "Enterprise Drupal development, custom module creation, and performance optimization at scale"
          },
          {
            "@type": "Service",
            "name": "Full-Stack Development",
            "description": "Production-grade web applications with React, Next.js, Node.js, and cloud infrastructure"
          }
        ]
      }
    </script>
  </body>
</html>
